rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedSchoolGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().split('@').size() == 2
        && (
          request.auth.token.email.lower().split('@')[1] == 'bcc.vic.edu.au'
          || request.auth.token.email.lower().split('@')[1] == 'baysidecc.vic.edu.au'
        );
    }

    function isValidGame(game) {
      return game in ['quick', 'times', 'missing'];
    }

    function hasValidScoreFields() {
      return request.resource.data.keys().hasOnly(['name', 'score', 'uid', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.uid == request.auth.uid;
    }

    match /leaderboards/{game}/scores/{scoreId} {
      allow read: if isValidGame(game);

      allow create: if isAllowedSchoolGoogleUser()
        && isValidGame(game)
        && scoreId == request.auth.uid
        && hasValidScoreFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAllowedSchoolGoogleUser()
        && isValidGame(game)
        && scoreId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && hasValidScoreFields()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.score > resource.data.score;

      allow delete: if false;
    }
  }
}
