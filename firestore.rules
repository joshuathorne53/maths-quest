rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasValidSchoolGoogleAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().split('@').size() == 2;
    }

    function userDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }

    function isStudentUser() {
      return hasValidSchoolGoogleAuth()
        && exists(studentDirectoryPath())
        && isValidYearLevel(get(studentDirectoryPath()).data.yearLevel);
    }

    function isTeacherUser() {
      return hasValidSchoolGoogleAuth()
        && userDomain() == 'baysidecc.vic.edu.au';
    }

    function isAllowedSchoolGoogleUser() {
      return isStudentUser() || isTeacherUser();
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isAdminUser() {
      return hasValidSchoolGoogleAuth()
        && userEmail() == 'joshua.thorne@baysidecc.vic.edu.au';
    }

    function validYearLevels() {
      return [
        'year7',
        'year8',
        'year9',
        'year10',
        'year11',
        'year12'
      ];
    }

    function isValidYearLevel(yearLevel) {
      return yearLevel in validYearLevels();
    }

    function isValidYearLevelList(yearLevels) {
      return yearLevels is list
        && yearLevels.size() >= 1
        && yearLevels.size() <= 6
        && yearLevels.hasOnly(validYearLevels());
    }

    function isValidGame(game) {
      return game in [
        'topic-speed-operations',
        'topic-number',
        'topic-fractions'
      ];
    }

    function yearRank(yearLevel) {
      return yearLevel == 'year7' ? 7
        : yearLevel == 'year8' ? 8
        : yearLevel == 'year9' ? 9
        : yearLevel == 'year10' ? 10
        : yearLevel == 'year11' ? 11
        : yearLevel == 'year12' ? 12
        : 0;
    }

    function canStudentAccessGame(game, yearLevel) {
      return isValidGame(game)
        && yearRank(yearLevel) >= 7;
    }

    function isValidName(name) {
      return name is string
        && name.size() >= 1
        && name.size() <= 80;
    }

    function hasValidStudentProfileFields() {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'yearLevel', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && isValidName(request.resource.data.name)
        && request.resource.data.email == userEmail()
        && isValidYearLevel(request.resource.data.yearLevel);
    }

    function hasValidTeacherProfileFields() {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'approved', 'yearLevels', 'createdAt', 'approvedAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && isValidName(request.resource.data.name)
        && request.resource.data.email == userEmail()
        && request.resource.data.approved == true
        && isValidYearLevelList(request.resource.data.yearLevels);
    }

    function preservesOrBackfillsCreatedAt() {
      return resource.data.keys().hasAll(['createdAt'])
        ? request.resource.data.createdAt == resource.data.createdAt
        : request.resource.data.createdAt == request.time;
    }

    function preservesOrBackfillsApprovedAt() {
      return resource.data.keys().hasAll(['approvedAt'])
        ? request.resource.data.approvedAt == resource.data.approvedAt
        : request.resource.data.approvedAt == request.time;
    }

    function studentDirectoryPath() {
      return /databases/$(database)/documents/studentDirectory/$(userEmail());
    }

    function teacherProfilePath() {
      return /databases/$(database)/documents/teachers/$(request.auth.uid);
    }

    function isApprovedTeacher() {
      return exists(teacherProfilePath())
        && get(teacherProfilePath()).data.approved == true;
    }

    function hasSavedTeacherYears() {
      return isApprovedTeacher()
        && isValidYearLevelList(get(teacherProfilePath()).data.yearLevels);
    }

    function hasSavedStudentYear(yearLevel) {
      return isStudentUser()
        && get(studentDirectoryPath()).data.yearLevel == yearLevel;
    }

    function savedStudentYearLevel() {
      return get(studentDirectoryPath()).data.yearLevel;
    }

    function canStudentReadScore(game) {
      return isStudentUser()
        && canStudentAccessGame(game, savedStudentYearLevel())
        && (
          (
            resource.data.role == 'student'
            && resource.data.yearLevel == savedStudentYearLevel()
          )
          || (
            resource.data.role == 'teacher'
            && resource.data.yearLevel == savedStudentYearLevel()
          )
        );
    }

    function canTeacherReadScore() {
      return isTeacherUser()
        && isApprovedTeacher();
    }

    function hasValidBaseScoreFields(game) {
      return isValidName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.bestStreak is int
        && request.resource.data.bestStreak >= 0
        && request.resource.data.bestStreak <= 1000
        && (
          !request.resource.data.keys().hasAny(['bestTopicBronzeStreak'])
          || (
            request.resource.data.bestTopicBronzeStreak is int
            && request.resource.data.bestTopicBronzeStreak >= 0
            && request.resource.data.bestTopicBronzeStreak <= 1000
          )
        )
        && (
          !request.resource.data.keys().hasAny(['bestBronzeStreak'])
          || (
            request.resource.data.bestBronzeStreak is int
            && request.resource.data.bestBronzeStreak >= 0
            && request.resource.data.bestBronzeStreak <= 1000
          )
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.game == game;
    }

    function hasValidStudentScoreFields(game) {
      return request.resource.data.keys().hasOnly(['name', 'score', 'bestStreak', 'bestBronzeStreak', 'bestTopicBronzeStreak', 'uid', 'role', 'yearLevel', 'game', 'createdAt', 'updatedAt'])
        && hasValidBaseScoreFields(game)
        && isStudentUser()
        && request.resource.data.role == 'student'
        && isValidYearLevel(request.resource.data.yearLevel)
        && canStudentAccessGame(game, request.resource.data.yearLevel)
        && hasSavedStudentYear(request.resource.data.yearLevel);
    }

    function hasValidTeacherScoreFields(game) {
      return request.resource.data.keys().hasOnly(['name', 'score', 'bestStreak', 'bestBronzeStreak', 'bestTopicBronzeStreak', 'uid', 'role', 'yearLevel', 'teacherYearLevels', 'game', 'createdAt', 'updatedAt'])
        && hasValidBaseScoreFields(game)
        && isTeacherUser()
        && request.resource.data.role == 'teacher'
        && isValidYearLevel(request.resource.data.yearLevel)
        && canStudentAccessGame(game, request.resource.data.yearLevel)
        && hasSavedTeacherYears()
        && get(teacherProfilePath()).data.yearLevels.hasAny([request.resource.data.yearLevel])
        && request.resource.data.teacherYearLevels == get(teacherProfilePath()).data.yearLevels
        && isValidYearLevelList(request.resource.data.teacherYearLevels);
    }

    function hasValidScoreFields(game) {
      return hasValidStudentScoreFields(game) || hasValidTeacherScoreFields(game);
    }

    function hasValidScoreDocumentId(scoreId) {
      return (
          request.resource.data.role == 'teacher'
          && scoreId == request.auth.uid + '_' + request.resource.data.yearLevel
        )
        || (
          request.resource.data.role == 'student'
          && (
            scoreId == request.auth.uid
            || scoreId == request.auth.uid + '_' + request.resource.data.yearLevel
          )
        );
    }

    function hasValidStudentDirectoryFields(directoryEmail) {
      return request.resource.data.keys().hasOnly(['email', 'yearLevel', 'source', 'updatedBy', 'importedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.email == directoryEmail
        && isValidYearLevel(request.resource.data.yearLevel)
        && request.resource.data.updatedAt == request.time;
    }

    function isValidRequestStatus(status) {
      return status in ['new', 'assigned'];
    }

    function hasValidYearLevelRequestBaseFields() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'status',
          'notifyEmail',
          'assignedYearLevel',
          'resolvedBy',
          'createdAt',
          'resolvedAt',
          'updatedAt'
        ])
        && request.resource.data.uid is string
        && isValidName(request.resource.data.name)
        && request.resource.data.email is string
        && isValidRequestStatus(request.resource.data.status)
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidStudentYearLevelRequestCreate() {
      return hasValidYearLevelRequestBaseFields()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail()
        && request.resource.data.status == 'new'
        && request.resource.data.notifyEmail is string
        && request.resource.data.createdAt == request.time;
    }

    function hasValidStudentYearLevelRequestUpdate() {
      return hasValidYearLevelRequestBaseFields()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail()
        && request.resource.data.status == 'new'
        && preservesOrBackfillsCreatedAt();
    }

    function hasValidAdminYearLevelRequestUpdate() {
      return hasValidYearLevelRequestBaseFields()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && preservesOrBackfillsCreatedAt()
        && request.resource.data.status == 'assigned'
        && isValidYearLevel(request.resource.data.assignedYearLevel)
        && request.resource.data.resolvedBy == userEmail()
        && request.resource.data.resolvedAt == request.time;
    }

    match /studentDirectory/{directoryEmail} {
      allow read: if isAdminUser()
        || (
          hasValidSchoolGoogleAuth()
          && directoryEmail == userEmail()
        );

      allow create, update: if isAdminUser()
        && hasValidStudentDirectoryFields(directoryEmail);

      allow delete: if false;
    }

    match /yearLevelRequests/{requestId} {
      allow read: if isAdminUser()
        || (
          hasValidSchoolGoogleAuth()
          && resource.data.uid == request.auth.uid
        );

      allow create: if hasValidSchoolGoogleAuth()
        && requestId == request.auth.uid
        && hasValidStudentYearLevelRequestCreate();

      allow update: if (
          hasValidSchoolGoogleAuth()
          && requestId == request.auth.uid
          && hasValidStudentYearLevelRequestUpdate()
        )
        || (
          isAdminUser()
          && hasValidAdminYearLevelRequestUpdate()
        );

      allow delete: if false;
    }

    match /studentProfiles/{profileId} {
      allow read: if hasValidSchoolGoogleAuth()
        && profileId == request.auth.uid;

      allow create: if isStudentUser()
        && profileId == request.auth.uid
        && hasValidStudentProfileFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStudentUser()
        && profileId == request.auth.uid
        && hasValidStudentProfileFields()
        && request.resource.data.uid == resource.data.uid
        && preservesOrBackfillsCreatedAt()
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if isTeacherUser()
        && teacherId == request.auth.uid;

      allow create: if isTeacherUser()
        && teacherId == request.auth.uid
        && hasValidTeacherProfileFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.approvedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isTeacherUser()
        && teacherId == request.auth.uid
        && resource.data.approved == true
        && hasValidTeacherProfileFields()
        && request.resource.data.uid == resource.data.uid
        && preservesOrBackfillsCreatedAt()
        && preservesOrBackfillsApprovedAt()
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /leaderboards/{game}/scores/{scoreId} {
      allow read: if isValidGame(game)
        && (canStudentReadScore(game) || canTeacherReadScore());

      allow create: if isAllowedSchoolGoogleUser()
        && isValidGame(game)
        && hasValidScoreFields(game)
        && hasValidScoreDocumentId(scoreId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAllowedSchoolGoogleUser()
        && isValidGame(game)
        && resource.data.uid == request.auth.uid
        && hasValidScoreFields(game)
        && hasValidScoreDocumentId(scoreId)
        && request.resource.data.uid == resource.data.uid
        && preservesOrBackfillsCreatedAt()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.score >= resource.data.score;

      allow delete: if false;
    }
  }
}
