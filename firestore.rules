rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasValidSchoolGoogleAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower().split('@').size() == 2;
    }

    function userDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }

    function isStudentUser() {
      return hasValidSchoolGoogleAuth()
        && userDomain() == 'bcc.vic.edu.au';
    }

    function isTeacherUser() {
      return hasValidSchoolGoogleAuth()
        && userDomain() == 'baysidecc.vic.edu.au';
    }

    function isAllowedSchoolGoogleUser() {
      return isStudentUser() || isTeacherUser();
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function validYearLevels() {
      return [
        'year7',
        'year8',
        'year9',
        'year10',
        'year11',
        'year12'
      ];
    }

    function isValidYearLevel(yearLevel) {
      return yearLevel in validYearLevels();
    }

    function isValidYearLevelList(yearLevels) {
      return yearLevels is list
        && yearLevels.size() >= 1
        && yearLevels.size() <= 6
        && yearLevels.hasOnly(validYearLevels());
    }

    function isValidGame(game) {
      return game in [
        'quick',
        'times',
        'missing',
        'y7-integers',
        'y7-fractions',
        'y7-percentages',
        'y7-bidmas',
        'y7-one-step-equations',
        'y8-square-powers',
        'y8-ratios',
        'y8-percentage-change',
        'y8-linear-equations',
        'y9-index-laws',
        'y9-gradients',
        'y9-expanding-brackets',
        'y9-two-step-equations',
        'y10-quadratics',
        'y10-pythagoras',
        'y10-simultaneous-equations',
        'y10-functions',
        'y11-derivatives',
        'y11-logarithms',
        'y11-arithmetic-sequences',
        'y11-surds',
        'y12-calculus-derivatives',
        'y12-integrals',
        'y12-complex-numbers',
        'y12-series'
      ];
    }

    function yearRank(yearLevel) {
      return yearLevel == 'year7' ? 7
        : yearLevel == 'year8' ? 8
        : yearLevel == 'year9' ? 9
        : yearLevel == 'year10' ? 10
        : yearLevel == 'year11' ? 11
        : yearLevel == 'year12' ? 12
        : 0;
    }

    function gameRequiredYear(game) {
      return game in [
          'y8-square-powers',
          'y8-ratios',
          'y8-percentage-change',
          'y8-linear-equations'
        ] ? 8
        : game in [
          'y9-index-laws',
          'y9-gradients',
          'y9-expanding-brackets',
          'y9-two-step-equations'
        ] ? 9
        : game in [
          'y10-quadratics',
          'y10-pythagoras',
          'y10-simultaneous-equations',
          'y10-functions'
        ] ? 10
        : game in [
          'y11-derivatives',
          'y11-logarithms',
          'y11-arithmetic-sequences',
          'y11-surds'
        ] ? 11
        : game in [
          'y12-calculus-derivatives',
          'y12-integrals',
          'y12-complex-numbers',
          'y12-series'
        ] ? 12
        : 7;
    }

    function canStudentAccessGame(game, yearLevel) {
      return yearRank(yearLevel) >= gameRequiredYear(game);
    }

    function isValidName(name) {
      return name is string
        && name.size() >= 1
        && name.size() <= 80;
    }

    function hasValidStudentProfileFields() {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'yearLevel', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && isValidName(request.resource.data.name)
        && request.resource.data.email == userEmail()
        && isValidYearLevel(request.resource.data.yearLevel);
    }

    function hasValidTeacherProfileFields() {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'approved', 'yearLevels', 'createdAt', 'approvedAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && isValidName(request.resource.data.name)
        && request.resource.data.email == userEmail()
        && request.resource.data.approved == true
        && isValidYearLevelList(request.resource.data.yearLevels);
    }

    function studentProfilePath() {
      return /databases/$(database)/documents/studentProfiles/$(request.auth.uid);
    }

    function teacherProfilePath() {
      return /databases/$(database)/documents/teachers/$(request.auth.uid);
    }

    function isApprovedTeacher() {
      return exists(teacherProfilePath())
        && get(teacherProfilePath()).data.approved == true;
    }

    function hasSavedTeacherYears() {
      return isApprovedTeacher()
        && isValidYearLevelList(get(teacherProfilePath()).data.yearLevels);
    }

    function hasSavedStudentYear(yearLevel) {
      return exists(studentProfilePath())
        && get(studentProfilePath()).data.yearLevel == yearLevel;
    }

    function hasValidBaseScoreFields(game) {
      return isValidName(request.resource.data.name)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.game == game;
    }

    function hasValidStudentScoreFields(game) {
      return request.resource.data.keys().hasOnly(['name', 'score', 'uid', 'role', 'yearLevel', 'game', 'createdAt', 'updatedAt'])
        && hasValidBaseScoreFields(game)
        && isStudentUser()
        && request.resource.data.role == 'student'
        && isValidYearLevel(request.resource.data.yearLevel)
        && canStudentAccessGame(game, request.resource.data.yearLevel)
        && hasSavedStudentYear(request.resource.data.yearLevel);
    }

    function hasValidTeacherScoreFields(game) {
      return request.resource.data.keys().hasOnly(['name', 'score', 'uid', 'role', 'teacherYearLevels', 'game', 'createdAt', 'updatedAt'])
        && hasValidBaseScoreFields(game)
        && isTeacherUser()
        && request.resource.data.role == 'teacher'
        && hasSavedTeacherYears()
        && request.resource.data.teacherYearLevels == get(teacherProfilePath()).data.yearLevels
        && isValidYearLevelList(request.resource.data.teacherYearLevels);
    }

    function hasValidScoreFields(game) {
      return hasValidStudentScoreFields(game) || hasValidTeacherScoreFields(game);
    }

    match /studentProfiles/{profileId} {
      allow read: if isAllowedSchoolGoogleUser()
        && profileId == request.auth.uid;

      allow create: if isStudentUser()
        && profileId == request.auth.uid
        && hasValidStudentProfileFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStudentUser()
        && profileId == request.auth.uid
        && hasValidStudentProfileFields()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if isTeacherUser()
        && teacherId == request.auth.uid;

      allow create: if isTeacherUser()
        && teacherId == request.auth.uid
        && hasValidTeacherProfileFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.approvedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isTeacherUser()
        && teacherId == request.auth.uid
        && resource.data.approved == true
        && hasValidTeacherProfileFields()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.approvedAt == resource.data.approvedAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /leaderboards/{game}/scores/{scoreId} {
      allow read: if isValidGame(game);

      allow create: if isAllowedSchoolGoogleUser()
        && isValidGame(game)
        && scoreId == request.auth.uid
        && hasValidScoreFields(game)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAllowedSchoolGoogleUser()
        && isValidGame(game)
        && scoreId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && hasValidScoreFields(game)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.score >= resource.data.score;

      allow delete: if false;
    }
  }
}
